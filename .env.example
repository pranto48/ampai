# =============================================================================
# AmpAI Personal Agent - Environment Variables
# =============================================================================
# Copy this file to .env and replace all <CHANGE_ME> placeholder values
# before starting the application.
#
# Variables marked [REQUIRED] must be set before the server will start.
# Variables marked [OPTIONAL] have sensible defaults and can be omitted.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string for the application database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Example uses the Docker Compose service name "agent_postgres" as host.
DATABASE_URL=postgresql://ampai:<CHANGE_ME>@agent_postgres:5432/ampai

# [OPTIONAL] PostgreSQL database name used by the agent_postgres container.
# Default: ampai
POSTGRES_DB=ampai

# [OPTIONAL] PostgreSQL user used by the agent_postgres container.
# Default: ampai
POSTGRES_USER=ampai

# [REQUIRED] PostgreSQL password for the agent_postgres container.
# Must NOT be left as a default value in production.
POSTGRES_PASSWORD=<CHANGE_ME>

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# [REQUIRED] Redis connection string for session caching and message history.
# Example uses the Docker Compose service name "agent_redis" as host.
REDIS_URL=redis://agent_redis:6379/0

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# [REQUIRED] Secret key used for signing JWT tokens.
# Must be a long random string. Must NOT be left as a default value in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=<CHANGE_ME>

# [REQUIRED] Default admin account username created on first startup.
# Default: admin
AMPAI_DEFAULT_ADMIN_USERNAME=admin

# [REQUIRED] Default admin account password created on first startup.
# Must NOT be left as a default value in production.
AMPAI_DEFAULT_ADMIN_PASSWORD=<CHANGE_ME>

# [OPTIONAL] Default admin account email for superuser initialization.
# Default: admin@ampai.local
DEFAULT_ADMIN_EMAIL=admin@ampai.local

# [OPTIONAL] Default admin account password. If set, this superuser will be created on startup.
DEFAULT_ADMIN_PASSWORD=

# [OPTIONAL] Encryption key for storing sensitive configuration values (e.g., browser credentials).
# If not set, encrypted storage features will be unavailable.
# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------

# [OPTIONAL] Application environment mode.
# Values: "development", "production", "prod"
# In production mode, the server will refuse to start with unsafe default credentials.
# Default: development
AMPAI_ENV=development

# -----------------------------------------------------------------------------
# AI Model Providers
# -----------------------------------------------------------------------------

# [OPTIONAL] Base URL for the local Ollama instance.
# Used for local LLM inference and embeddings (nomic-embed-text).
# Default: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# CORS / Allowed Origins
# -----------------------------------------------------------------------------

# [OPTIONAL] Comma-separated list of allowed CORS origins for the API.
# Include the Tauri desktop app origin and any web frontends.
# Default: http://localhost:1420,http://127.0.0.1:1420,tauri://localhost
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# -----------------------------------------------------------------------------
# Telegram Bot Integration
# -----------------------------------------------------------------------------

# [OPTIONAL] Telegram Bot API token obtained from @BotFather.
# Leave empty to disable Telegram integration.
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Web Search
# -----------------------------------------------------------------------------

# [OPTIONAL] Preferred web search provider.
# Values: "duckduckgo" (default, no API key needed), "tavily", "serpapi", "brave"
# DuckDuckGo is used as the default fallback when no key is required.
# Default: duckduckgo
WEB_SEARCH_PROVIDER=duckduckgo

# -----------------------------------------------------------------------------
# Browser Automation
# -----------------------------------------------------------------------------

# [OPTIONAL] Enable or disable browser automation tools.
# Disabled by default for security. Must be explicitly enabled by an admin.
# Values: "true" or "false"
# Default: false
BROWSER_AUTOMATION_ENABLED=false

# [OPTIONAL] Run the browser in headless mode (no visible window).
# Default is headed (false) so the user can observe browser actions.
# Values: "true" or "false"
# Default: false
BROWSER_HEADLESS=false

# -----------------------------------------------------------------------------
# Terminal Tools
# -----------------------------------------------------------------------------

# [OPTIONAL] Enable or disable terminal command execution tools.
# Disabled by default for security. Must be explicitly enabled by an admin.
# Values: "true" or "false"
# Default: false
TERMINAL_TOOLS_ENABLED=false

# [OPTIONAL] Require user confirmation before executing each terminal command.
# Strongly recommended to keep enabled for safety.
# Values: "true" or "false"
# Default: true
TERMINAL_REQUIRE_CONFIRMATION=true
