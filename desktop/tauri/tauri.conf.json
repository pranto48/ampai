{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AmpAI Desktop",
  "version": "0.1.0",
  "identifier": "com.ampai.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:18000",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "AmpAI Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost http://localhost:* http://127.0.0.1:* https://*; connect-src 'self' tauri: http://localhost:* http://127.0.0.1:* https://* ws://localhost:* ws://127.0.0.1:* wss://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:* https://*"
    }
  },
  "plugins": {
    "store": {
      "autoSave": 500
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [],
    "resources": []
  },
  "permissions": [
    "core:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-load",
    "store:allow-save",
    "http:default",
    "shell:allow-open"
  ]
}
